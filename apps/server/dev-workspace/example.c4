// Локальный dev workspace: используется по умолчанию в `npm run dev`
// (apps/server/package.json), когда оператор не задал LIKEC4_WORKSPACE.

specification {
  element requirement {
    style {
      shape rectangle
    }
  }
}

model {
  dev = requirement {
    title 'Dev'
  }
}

views {
  view overview {
    title 'Overview'
    include *
  }
}
